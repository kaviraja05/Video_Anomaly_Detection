# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Model Configuration
MODEL_PATH=models/proposed_model.pth
DEVICE=cpu  # Options: cpu, cuda
BATCH_SIZE=1

# Data Configuration
DATA_DIR=data/i3d_features
TRAIN_DIR=data/i3d_features/train
TEST_DIR=data/i3d_features/test

# Memory Bank Configuration
MEMORY_BANK_SIZE=5000
RETRIEVAL_TOP_K=5
CACHE_ENABLED=True

# API Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
API_TITLE=Video Anomaly Detection API
API_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Extraction
FEATURE_DIM=2048
HIDDEN_DIM=512
NUM_SEGMENTS=32

# Training Configuration (for train.py)
LEARNING_RATE=0.0001
EPOCHS=100
EARLY_STOPPING_PATIENCE=10
CHECKPOINT_DIR=checkpoints/

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENABLE_ANALYTICS=false
